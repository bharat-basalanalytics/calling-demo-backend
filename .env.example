# Environment
NODE_ENV=development  # or 'production'

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
MONGO_PWD=your_mongo_password_here

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# JWT
HWL_JWT_EXPIRES_IN=7d
JWT_SECRET=your_super_secret_key
USER_KEY_COOKIE=user_session_token

# Redis (Local)
REDIS_LOCAL_HOST=127.0.0.1
REDIS_LOCAL_PORT=6379

# Redis (Cloud)
REDIS_CLOUD_HOST=redis-cloud-host-url
REDIS_CLOUD_PORT=12345
REDIS_CLOUD_ACCESS_KEY=your_redis_cloud_access_key

# External APIs
GSA_API_KEY=your_gsa_api_key
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
MAPBOX_ACCESS_TOKEN=your_mapbox_token
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
LOGIC_APP_KEY=your_azure_logic_app_key

# Power BI (Service Principal)
POWERBI_TENANT_ID=your_tenant_id_guid
POWERBI_CLIENT_ID=your_client_id_guid
POWERBI_CLIENT_SECRET=your_client_secret_value
POWERBI_WORKSPACE_ID=your_workspace_id_guid
POWERBI_REPORT_ID=your_report_id_guid

# VAPI (Voice AI Platform)
VAPI_PRIVATE_API_KEY=your_vapi_private_api_key
